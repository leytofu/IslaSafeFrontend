# Frontend application settings
VITE_APP_NAME=IslaSafe Admin
VITE_APP_ENV=development

# Backend API integration
VITE_API_BASE_URL=http://localhost:8000/api
VITE_API_TIMEOUT_MS=15000

# MapLibre configuration
VITE_MAP_PROVIDER=maplibre
VITE_MAP_TILE_PROVIDER=esri
VITE_MAP_API_KEY=

# Satellite imagery
VITE_MAP_TILE_URL=https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}
VITE_MAP_ATTRIBUTION=Tiles © Esri — Source: Esri, Maxar, Earthstar Geographics, and the GIS User Community

# Street map
VITE_MAP_STREETS_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_STREETS_ATTRIBUTION=© OpenStreetMap contributors
VITE_MAP_MAX_ZOOM=19

# Local development behavior
VITE_ENABLE_MOCK_DATA=false
 
